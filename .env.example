# API_ID：Telegram 应用的 api_id。
API_ID=
# API_HASH：Telegram 应用的 api_hash。
API_HASH=
# BOT_TOKEN：bot 的 token（@BotFather 新建一个 bot 拿）。
BOT_TOKEN=
# ALLOWED_USER_IDS：能用这个 bot 的 Telegram 用户 ID，多个用逗号隔开；为空谁都不能用。
ALLOWED_USER_IDS=
# ARIA2_SECRET：aria2 RPC 密钥。不填也行，bot 第一次启动会自动生成，存进 aria2-secret.txt。
ARIA2_SECRET=
# ARIA2_BIN：aria2c 二进制路径，默认 ./bin/aria2c（setup.sh 会下到这里）。
# ARIA2_BIN=./bin/aria2c
# RCLONE_BIN：rclone 二进制路径，默认 ./bin/rclone（setup.sh 会下到这里）；不存在就用系统 PATH 里的 rclone。
# RCLONE_BIN=./bin/rclone
# RCLONE_CONFIG：rclone 配置文件路径，默认 ~/.config/rclone/rclone.conf。
# RCLONE_CONFIG=~/.config/rclone/rclone.conf
# DOWNLOAD_DIR：下载临时目录，默认 ./downloads。
DOWNLOAD_DIR=./downloads
# MAX_CONCURRENT_TASKS：同时跑的下载任务数上限，默认 3；设 0 为不限制。
MAX_CONCURRENT_TASKS=3
# TIMEZONE：没设过时区的用户的默认时区，默认 Asia/Shanghai。
TIMEZONE=Asia/Shanghai
# SERVER_PORT：HTTP 保活端口，默认 8080。
SERVER_PORT=8080
